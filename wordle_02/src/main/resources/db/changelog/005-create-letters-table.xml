<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="5" author="Ivan">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="letters"/>
            </not>
        </preConditions>

        <createTable tableName="letters">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="letter" type="CHAR(1)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="attempt_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="letters"
                baseColumnNames="attempt_id"
                referencedTableName="attempts"
                referencedColumnNames="id"
                constraintName="fk_letters_attempt"/>
    </changeSet>

</databaseChangeLog>
