<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="7" author="Ivan">
        <dropForeignKeyConstraint baseTableName="letters" constraintName="fk_letters_attempt"/>
        <addForeignKeyConstraint
                baseTableName="letters"
                baseColumnNames="attempt_id"
                referencedTableName="attempts"
                referencedColumnNames="id"
                constraintName="fk_letters_attempt"
                onDelete="CASCADE"
                onUpdate="CASCADE"/>

    </changeSet>
</databaseChangeLog>
