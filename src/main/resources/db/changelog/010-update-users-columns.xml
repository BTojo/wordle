<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="10" author="Ivan">

        <renameColumn
                tableName="users"
                oldColumnName="id"
                newColumnName="user_id"
                columnDataType="UUID"/>

        <renameColumn
                tableName="games"
                oldColumnName="id"
                newColumnName="game_id"
                columnDataType="UUID"/>

        <renameColumn
                tableName="attempts"
                oldColumnName="id"
                newColumnName="attempt_id"
                columnDataType="UUID"/>

        <renameColumn
                tableName="letters"
                oldColumnName="id"
                newColumnName="letter_id"
                columnDataType="UUID"/>

    </changeSet>

</databaseChangeLog>